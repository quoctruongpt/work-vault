{
  "name": "work-vault",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-vault",
      "database_id": "ca5927f6-a213-4c8b-bbab-4214257358fc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "work-vault-files" }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}
